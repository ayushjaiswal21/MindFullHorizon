# Copy to .env and fill in. Never commit .env.

FLASK_ENV=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave unset in development to use instance/mindful_horizon.db.
# Production: a PostgreSQL URL, e.g. postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# AI (Google Gemini). Without a key the app uses canned fallback text.
GEMINI_API_KEY=
# GEMINI_MODEL_NAME=

# Google sign-in (optional)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: public bucket URL holding the binaural mp3s (see docs/DEVELOPMENT.md)
# AUDIO_BASE_URL=
