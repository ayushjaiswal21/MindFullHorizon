# Copy to .env and fill in. Never commit .env.

FLASK_ENV=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string
# Column-level encryption at rest for clinical free text (O-04, docs/TRACKER.md, utils/field_encryption.py).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production (the app refuses to start an encrypted-field write/read without it); losing this key
# makes every already-encrypted row unreadable, so back it up outside the database.
# FIELD_ENCRYPTION_KEY=

# Database. Leave unset in development to use instance/mindful_horizon.db.
# Production: a PostgreSQL URL, e.g. postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# AI (Google Gemini). Without a key the app uses canned fallback text.
GEMINI_API_KEY=
# Zero-cost policy (docs/LLM_SECURITY.md): 0 = nothing a student writes or that is tied to a user is sent to Gemini (default).
# 1 = send it; Google's free tier may use submitted content, so get the college's written approval first and record it below.
AI_SEND_PERSONAL_TEXT=0
# AI_PERSONAL_TEXT_APPROVED_BY=      # free-text record of the college's written approval (who, date); shown nowhere in the UI
# GEMINI_MODEL_NAME=

# Google sign-in (optional)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: public bucket URL holding the binaural mp3s (see docs/DEVELOPMENT.md)
# AUDIO_BASE_URL=

# Jobs, email and crisis escalation (docs/OPERATIONS.md)
# JOBS_INPROCESS=1                 # run the job worker inside the web process (default on in production, off otherwise)
# JOB_LOCK_TIMEOUT=300             # seconds before a stuck running job is requeued
# SMTP_HOST=
# SMTP_PORT=587                    # 587 = STARTTLS, 465 = SSL
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# CONTACT_RECIPIENT=               # where contact-form emails go
# CRISIS_ESCALATE_MINUTES=15       # minutes between escalation levels for an unacknowledged crisis alert
# CRISIS_ESCALATION_EMAIL=         # emailed at escalation level 2 and 3 (no patient text in the email)
# AI guards and resilience (docs/LLM_SECURITY.md)
# GEMINI_TIMEOUT=20               # seconds per request
# AI_MAX_RETRIES=2                # transient errors only, ceiling 2
# AI_BREAKER_FAILURES=5          # consecutive failures that open the circuit
# AI_BREAKER_RESET_SECONDS=60
# AI_DAILY_LIMIT=200             # AI messages per user per day
# AI_BURST_LIMIT=8               # AI messages per user per minute
# AI_MAX_REPLY_CHARS=600         # prompt limit and code clamp for chat replies
# Site shell (utils/site_context.py)
# SITE_URL=                      # public origin, no trailing slash, e.g. https://example.org. Used for canonical, Open Graph and JSON-LD URLs. Falls back to the request URL.
# CONSENT_VERSION=2026-11        # bump to show the cookie banner again after a policy change
# ASSET_VERSION=                 # optional ?v= token for CSS/JS; default is the newest file mtime
# The footer "Last updated" date is the SITE_LAST_UPDATED constant in utils/site_context.py (edit it when content changes).
# Deployment (docs/DEPLOY.md; check with `python scripts/predeploy_check.py`)
# PROVIDER_INVITE_CODE=            # counsellor signup code, 12+ chars; unset disables counsellor self-signup
# DOCTOR_INVITE_CODE=              # doctor signup code, 12+ chars, different from PROVIDER_INVITE_CODE; unset disables doctor self-signup
# GRIEVANCE_EMAIL=                 # shown on the privacy page
# DATA_FIDUCIARY_NAME=             # shown on the privacy page
# ENABLE_PRESCRIPTIONS=1           # owner decision: on (default); 0 hides every prescription route
# CORS_ORIGINS=                    # comma separated; empty = same origin only (Socket.IO)
# CSP_REPORT_ONLY=1               # emergency fallback only: send the CSP as Report-Only (blocks nothing). Default: enforcing
# SESSION_LIFETIME_HOURS=24
# DB_POOL_SIZE=5                   # also DB_MAX_OVERFLOW, DB_POOL_TIMEOUT, DB_POOL_RECYCLE, DB_STATEMENT_TIMEOUT_MS (PostgreSQL only)
# PORT=                            # set by Render (10000); the Dockerfile falls back to 5000
# Render and Neon (docs/DEPLOY.md section 13)
# TRUST_PROXY=0                    # 1 = trust one proxy hop (ProxyFix: scheme, host, client IP). Always on when FLASK_ENV=production
# LOG_TO_STDOUT=0                  # 1 = no log file, stdout only. Always on when FLASK_ENV=production (dev writes logs/mindful_horizon.log)
# JOB_IDLE_MAX_SECONDS=900         # idle job worker: longest sleep with nothing scheduled (60 for `flask jobs-worker`); a commit that enqueues wakes it at once
# DB_CONNECT_TIMEOUT=15            # seconds per PostgreSQL connect attempt (the first connect after a Neon wake retries 3 times)
# Clinical features (docs/CLINICAL_DESIGN.md section 8; admins are created only with `flask create-admin`, docs/ADMIN_SETUP.md)
# PRESCRIBER_REVIEW_DAYS=365       # how long a verification lasts before a re-check
# RX_EXPIRY_DAYS=30                # longest validity a doctor can choose (max 90)
# RX_MAX_ITEMS=6                   # medicines per prescription
# RX_MAX_DAYS_FIRST=14             # duration cap per medicine at a first consult (policy, not regulation)
# RX_MAX_DAYS_FOLLOWUP=30          # duration cap at a follow-up or in-person consult
# RX_CONSULT_WINDOW_HOURS=24       # how long a started consult qualifies for a prescription
# ERX_CONSENT_VERSION=2026-11      # version stored with the patient's e-prescription consent
# CATALOGUE_FOUR_EYES=1            # 1 = a second administrator must confirm a medicine's list classification
# INVENTORY_MIN_SHELF_DAYS=0       # batches expiring sooner than this are not dispensed
# INVENTORY_NEAR_EXPIRY_DAYS=60    # near-expiry alert and report window
# ALLOW_DEMO_DATA=0                # 1 allows demo medicines when FLASK_ENV=production (never for real patients)
CHAT_ROUTER_ENABLED=1               # lexical chat router (ai/router.py, ai/kb.py) answers ordinary messages instead of off_reply(); all 16 KB snippets clinician-reviewed 2026-11-25, see docs/review/signoff/
